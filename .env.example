APP_NAME=Personal Operations Copilot
# Leave blank for automatic selection: 0.0.0.0 in Codespaces, 127.0.0.1 elsewhere.
HOST=
PORT=8000
API_BASE_URL=http://127.0.0.1:8000
# Optional public URL for direct browser/API clients. In Codespaces this is derived automatically.
API_PUBLIC_URL=
# Optional comma-separated browser origins. Codespaces Streamlit origin is derived automatically.
FRONTEND_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
AUTH_PASSWORD_HASH=
SESSION_TTL_HOURS=12
TIMEZONE=Asia/Riyadh
DATABASE_URL=sqlite:///./data/app.db
FILES_DIR=./files
LOGS_DIR=./logs
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REMINDER_DAYS_DEFAULT=90,30,7,3,1
OCR_LANGUAGE=ara+eng
TESSERACT_CMD=
MAX_AI_TEXT_CHARS=12000
MAX_UPLOAD_SIZE_MB=25
ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=./backups
BACKUP_RETENTION=7
